{
  "name": "antigravity-mobile-sync",
  "displayName": "Mobile Sync",
  "description": "Edit the files open in Antigravity / VS Code from your phone browser, live, including unsaved changes. Runs only on your own network.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mobileSync.start",
        "title": "Start",
        "category": "Mobile Sync"
      },
      {
        "command": "mobileSync.stop",
        "title": "Stop",
        "category": "Mobile Sync"
      },
      {
        "command": "mobileSync.showLink",
        "title": "Show QR Code / Link",
        "category": "Mobile Sync"
      },
      {
        "command": "mobileSync.resetToken",
        "title": "Reset Secret Key",
        "category": "Mobile Sync"
      }
    ],
    "configuration": {
      "title": "Mobile Sync",
      "properties": {
        "mobileSync.port": {
          "type": "number",
          "default": 8765,
          "description": "Port for the phone to connect to."
        },
        "mobileSync.host": {
          "type": "string",
          "default": "0.0.0.0",
          "description": "Network address to listen on. 0.0.0.0 = all networks (Wi-Fi and Tailscale). Set to your Tailscale IP (100.x.x.x) to accept connections only over Tailscale."
        },
        "mobileSync.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Start the server automatically when the editor opens."
        },
        "mobileSync.notifyOnConnect": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification whenever a phone connects."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && vsce package --no-dependencies --allow-missing-repository -o mobile-sync.vsix",
    "test": "node build.mjs && node test/run.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@vscode/vsce": "^4.1.1",
    "codemirror": "^6.0.1",
    "esbuild": "^0.24.2",
    "qrcode-generator": "^1.4.4"
  }
}
